#!/usr/bin/env python3
"""Verify the stoichiometric coefficient for 2HNO2 + O2 -> xHNO3"""
import re

def parse_formula(formula):
    """Parse a chemical formula and return a dict of element counts."""
    # This simple parser handles formulas like HNO2, O2, HNO3
    pattern = r'([A-Z][a-z]?)(\d*)'
    elements = {}
    for element, count in re.findall(pattern, formula):
        count = int(count) if count else 1
        elements[element] = elements.get(element, 0) + count
    return elements

# Reactants: 2 HNO2 + 1 O2
