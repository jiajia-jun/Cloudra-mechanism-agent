/* Cloudra Textual TUI 样式 */

Screen {
    layout: vertical;
}

#main-body {
    width: 100%;
    height: 1fr;
}

#chat-area {
    width: 1fr;
    height: 100%;
}

#chat-log {
    height: 1fr;
    border: solid $primary;
    padding: 1;
}

#input-bar {
    height: auto;
    min-height: 3;
    border: solid $primary;
    padding: 0 1;
}

#input-row {
    height: auto;
    min-height: 3;
}

/* 斜杠命令补全弹层：默认隐藏 */
#command-suggest {
    display: none;
    height: auto;
    max-height: 8;
    border: solid $secondary;
}

/* 侧栏：默认隐藏，Ctrl+B / /agents 切换 */
#side-panel {
    width: 36;
    display: none;
    border-left: solid $primary;
    padding: 0 1;
}

#side-panel .side-title {
    text-style: bold;
    color: $text-muted;
    padding: 0 1;
}

#agent-list {
    height: auto;
    max-height: 40%;
    border: solid $secondary;
    margin-bottom: 1;
}

#conv-list {
    height: 1fr;
    border: solid $secondary;
}

/* 计划区：目标锚点 + todo 清单 + token 用量 */
#plan-view {
    height: auto;
    max-height: 30%;
    border: solid $secondary;
    padding: 0 1;
    margin-top: 1;
    color: $text;
    overflow-y: auto;
}

/* DAG 区：模式 + 双图 revision + frontier + 阻塞/缺口计数 */
#dag-view {
    height: auto;
    max-height: 30%;
    border: solid $secondary;
    padding: 0 1;
    margin-top: 1;
    color: $text;
    overflow-y: auto;
}

#session-label {
    width: auto;
    min-width: 10;
    content-align: center middle;
    color: $text-muted;
}

#message-input {
    width: 1fr;
    /* TextArea 默认 height:1fr 会撑爆整个输入栏，必须显式定高 */
    height: 5;
    max-height: 12;
}

#send-button {
    width: auto;
    min-width: 8;
}

#status-bar {
    height: 1;
    background: $surface;
    color: $text;
    padding: 0 1;
}

/* 发送失败的用户消息标灰 */
.send-failed {
    color: $text-muted;
    text-style: dim strike;
}

#welcome {
    color: $text-muted;
    padding: 1 2;
}

/* Modal 弹窗 */
ApprovalModal, AskUserModal, DagEditModal {
    align: center middle;
}

#approval-dialog, #ask-dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: thick $background 80%;
    background: $surface;
    padding: 1 2;
}

/* DAG 编辑表单：多行输入框，纵向堆叠 */
#dag-edit-dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    border: thick $background 80%;
    background: $surface;
    padding: 1 2;
    grid-size: 1;
    grid-rows: auto;
}

#dag-edit-dialog Input, #dag-edit-dialog Select {
    margin-bottom: 1;
}

#dag-edit-title {
    text-align: center;
    text-style: bold;
}

#edit-error {
    color: $error;
    height: auto;
}

#dag-edit-buttons {
    grid-size: 2;
    height: auto;
    margin-top: 1;
}

#approval-title, #ask-title {
    text-align: center;
    text-style: bold;
}

#approval-details, #ask-prompt {
    height: auto;
    margin: 1 0;
}

#ask-prompt-scroll {
    height: auto;
    max-height: 20;
    margin: 1 0;
    overflow-y: auto;
}

#approval-buttons, #ask-buttons {
    grid-size: 3;
    height: auto;
    margin-top: 1;
}

#help-scroll {
    padding: 1 2;
}

#help-content {
    width: 100%;
    height: auto;
}
