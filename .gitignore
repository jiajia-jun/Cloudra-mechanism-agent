.worktrees/

# Frontend
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/src-tauri/target/
# 桌面端分发产物与打包中间产物（scripts/package-desktop.sh 生成）
frontend/dist-app/
frontend/runtime-build/

# Chemistry job artifacts (Gaussian etc.)
fort.*
*.chk
*.gjf
*.log
*.out
# 测试用的真实引擎输出样本仍需入库。**按目录逐个列白名单已经漏过一次**（子目录里的
# `.out`/`.log` 样本没被覆盖，于是在本地能跑、到 CI 就 FileNotFoundError）：这里改成
# 整棵 fixtures 树的通配白名单，新加 fixture 目录不再需要回来改本文件。
!tests/fixtures/**/*.log
!tests/fixtures/**/*.out

# 测试泄漏的 mock 数据目录
MagicMock/

# Frontend (v2 Electron/React)
frontend/node_modules/
frontend/dist/

# runtime v2 local sqlite
runtime-v2.db*

# optional JS host local install (installed explicitly via npm ci)
cloudra/runtime_v2/js_host/node_modules/

# 运行时状态泄漏文件（如 Gaussian 作业 state json）
state_*.json

# 申报材料：本地留存，不上传公开仓库
互联网加申报材料/

# 软著材料打包产物（本地留存，源在 软著申请材料/）
*.zip

# Cloudra 运行时工作区目录与编译临时文件
.cloudra/
*.blg

# 调研下载的大型 PDF 文献库与 OCR 缓存（保留 Markdown 笔记与结构化 JSON）
docs/benchmark_survey/pdfs/
docs/benchmark_survey/md/
ideapool/**/*.pdf
!ideapool/cloudra_novelty_and_validation_plan.pdf
ideapool/**/images/
ideapool/**/img_*/



